# Base de los links públicos que comparte la app: {base}/noticia/{identificador}.
# Es pública (NEXT_PUBLIC_) porque se lee en el cliente. Sin ella: https://infomate.ar
NEXT_PUBLIC_URL_PUBLICA=https://infomate.ar

# ID del store público de Vercel Blob (store_...). Se lee /infomate/hoy.json.
# Vacía: usa datos/noticias.json para desarrollo local.
INFOMATE_STORE_ID=

# Solo para subir/actualizar archivos; no se necesita para leer el Blob público.
# Nunca usar un prefijo NEXT_PUBLIC_ para este token.
INFOMATE_READ_WRITE_TOKEN=
